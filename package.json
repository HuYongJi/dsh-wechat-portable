{
  "name": "dsh-wechat-portable",
  "version": "0.1.0-alpha.4",
  "description": "Community portable WeChat bridge for DSH 0.2; derived from lanbaolu/dsh-wechat-bridge (MIT).",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.19.0" },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "bin": { "dsh-wechat-portable": "./lib/portable/cli.js" },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "UPSTREAM.md", "docs/portable"],
  "upstream": {
    "repository": "https://github.com/lanbaolu/dsh-wechat-bridge",
    "version": "0.9.1",
    "commit": "555391e918104bdd65c4c5fd9c91dc4ff417a7f5"
  },
  "keywords": ["dsh", "dsh-plugin", "wechat", "portable"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2"
  },
  "dependencies": { "qrcode": "1.5.4", "qrcode-terminal": "0.12.0" },
  "bundledDependencies": ["qrcode", "qrcode-terminal"],
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.0",
    "@types/react": "^18.3.31",
    "tsdown": "0.22.14",
    "typescript": "^5.9.0",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "verify": "node scripts/verify.mjs",
    "prepack": "node scripts/verify.mjs"
  },
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./typert": { "types": "./lib/types/host/control.d.ts", "default": "./lib/host/control.js" },
    "./remote": { "types": "./lib/types/client/remote.d.ts", "default": "./lib/client/remote.js" },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-settings"],
      "platform": "web"
    }
  }
}
